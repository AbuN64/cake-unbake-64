{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "unbake:result.blobs",
 "type": "object",
 "properties": {
  "count": {
   "type": "integer",
   "minimum": 0
  },
  "census": {
   "type": "object",
   "additionalProperties": {
    "type": "object",
    "additionalProperties": {
     "type": "integer",
     "minimum": 0
    }
   }
  },
  "partition": {
   "type": "object",
   "additionalProperties": {
    "type": "object",
    "additionalProperties": {
     "type": "integer",
     "minimum": 0
    }
   }
  },
  "rows": {
   "type": "array",
   "items": {
    "type": "object"
   }
  },
  "imported": {
   "type": "object",
   "properties": {
    "added": {
     "type": "integer",
     "minimum": 0
    },
    "unchanged": {
     "type": "integer",
     "minimum": 0
    },
    "files": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "add": {
     "type": "string"
    },
    "commit": {
     "type": "string"
    }
   },
   "required": [
    "added",
    "unchanged",
    "files"
   ],
   "additionalProperties": false
  },
  "debt": {
   "type": "array",
   "items": {
    "type": "object"
   }
  },
  "scanned": {
   "type": "object",
   "additionalProperties": {
    "type": "object"
   }
  },
  "proved": {
   "type": "object",
   "properties": {
    "receipt": {
     "type": "string"
    },
    "sha256": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$"
    },
    "rows": {
     "type": "integer",
     "minimum": 1
    }
   },
   "required": [
    "receipt",
    "sha256",
    "rows"
   ],
   "additionalProperties": false
  }
 },
 "required": [
  "count",
  "census",
  "partition",
  "debt"
 ],
 "additionalProperties": false
}
