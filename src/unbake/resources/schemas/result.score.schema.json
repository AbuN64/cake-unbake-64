{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "unbake:result.score",
 "type": "object",
 "properties": {
  "unit": {"type": "string", "minLength": 1},
  "members": {"type": "array", "items": {"type": "string", "minLength": 1}},
  "version": {"type": "string", "minLength": 1},
  "versions": {"type": "array", "items": {"type": "string", "minLength": 1}},
  "exact": {"type": "boolean"},
  "score": {"type": "number", "minimum": 0, "maximum": 1},
  "words": {
   "type": "object",
   "properties": {
    "built": {"type": "integer", "minimum": 0},
    "target": {"type": "integer", "minimum": 0},
    "matched": {"type": "integer", "minimum": 0}
   },
   "required": ["built", "target", "matched"],
   "additionalProperties": false
  },
  "shift": {"type": "object"},
  "rewritten": {"type": "array", "items": {"type": "string"}},
  "source": {"type": "array", "items": {"type": "object"}},
  "alloc": {"type": "array", "items": {"type": "object"}},
  "sched": {"type": "array", "items": {"type": "object"}},
  "diff": {"type": "array", "items": {"type": "string"}},
  "proofs": {"type": "array", "items": {"type": "object"}},
  "variants": {"type": "array", "items": {"type": "object"}},
  "permute": {"type": "object"}
 },
 "anyOf": [
  {"required": ["permute"]},
  {"required": ["unit", "members", "version", "versions", "exact", "score", "words", "shift", "source", "diff", "proofs"]},
  {"required": ["variants"]}
 ],
 "additionalProperties": false
}
