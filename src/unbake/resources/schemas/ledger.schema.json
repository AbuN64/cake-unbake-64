   "const": 2
  },
  "kind": {
   "enum": [
    "receipt",
    "refusal",
    "drain"
   ]
  },
  "invocation": {
   "type": "string",
   "minLength": 1
  },
  "time": {
   "type": "string",
   "minLength": 1
  },
  "body": {
   "type": "object"
  }
 },
 "required": [
  "schema",
  "kind",
  "invocation",
  "time",
  "body"
 ],
 "additionalProperties": false
}
