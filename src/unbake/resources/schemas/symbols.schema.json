{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "unbake:symbols",
 "type": "object",
 "properties": {
  "schema": {
   "const": 1
  },
  "symbol": {
   "type": "object",
   "propertyNames": {
    "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
   },
   "additionalProperties": {
    "type": "object",
    "properties": {
     "kind": {
      "enum": [
       "function",
       "data"
      ]
     }
    },
    "required": [
     "kind"
    ],
    "additionalProperties": {
     "type": "integer",
     "minimum": 0
    }
   }
  },
  "functions": {
   "type": "array",
   "items": {
    "allOf": [
     {
      "type": "object",
      "required": [
       "name",
       "version"
      ],
      "properties": {
       "name": {
        "type": "string"
       },
       "version": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]+$"
       }
      }
     },
     {
      "type": "object",
      "required": [
       "address"
      ],
      "properties": {
       "address": {
        "type": "integer",
        "minimum": 0,
        "maximum": 4294967295
       }
      }
     }
    ]
   }
  },
  "structs": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "name",
     "version"
    ],
    "properties": {
     "name": {
      "type": "string"
     },
     "version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
     }
    }
   }
  },
  "typedefs": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "name",
     "version"
    ],
    "properties": {
     "name": {
      "type": "string"
     },
     "version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
     }
    }
   }
  },
  "enums": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "name",
     "version"
    ],
    "properties": {
     "name": {
      "type": "string"
     },
     "version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
     }
    }
   }
  }
 },
 "required": [
  "schema"
 ],
 "additionalProperties": false
}
