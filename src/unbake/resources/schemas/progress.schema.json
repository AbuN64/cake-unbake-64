     },
     "rom_size": {
      "type": "integer",
      "minimum": 0
     },
     "code": {
      "type": "object",
      "properties": {
       "matched": {
        "type": "integer",
        "minimum": 0
       },
       "total": {
        "type": "integer",
        "minimum": 0
       },
       "asm": {
        "type": "integer",
        "minimum": 0
       }
      },
      "required": [
       "matched",
       "total"
      ],
      "additionalProperties": false
     },
     "data": {
      "type": "object",
      "properties": {
       "matched": {
        "type": "integer",
        "minimum": 0
       },
       "total": {
        "type": "integer",
        "minimum": 0
       }
      },
      "required": [
       "matched",
       "total"
      ],
      "additionalProperties": false
     },
     "functions": {
      "type": "object",
      "properties": {
       "matched": {
        "type": "integer",
        "minimum": 0
       },
       "total": {
        "type": "integer",
        "minimum": 0
       },
       "asm": {
        "type": "integer",
        "minimum": 0
       }
      },
      "required": [
       "matched",
       "total"
      ],
      "additionalProperties": false
     },
     "linker_fill": {
      "type": "object",
