        "type": "integer",
        "minimum": 0
       },
       "pi": {
        "type": "object",
        "properties": {
         "release": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
         },
         "page_size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
         },
         "pulse_width": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
         },
         "latency": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
         }
        },
        "required": [
         "release",
         "page_size",
         "pulse_width",
         "latency"
        ],
        "additionalProperties": false
       },
       "clock_rate": {
        "type": "integer",
        "minimum": 0,
        "maximum": 4294967295
       },
       "entry_point": {
        "type": "integer",
        "minimum": 0,
        "maximum": 4294967295
       },
       "release": {
        "type": "string"
       },
       "crc1": {
        "type": "integer",
        "minimum": 0,
        "maximum": 4294967295
       },
       "crc2": {
        "type": "integer",
        "minimum": 0,
        "maximum": 4294967295
       },
