       "bytes": {
        "type": "integer",
        "minimum": 0
       }
      },
      "required": [
       "bytes"
      ],
      "additionalProperties": false
     },
     "blobs": {
      "type": "object",
      "properties": {
       "decoded": {
        "type": "integer",
        "minimum": 0
       },
       "total": {
        "type": "integer",
        "minimum": 0
       }
      },
      "required": [
       "decoded",
       "total"
      ],
      "additionalProperties": false
     },
     "header": {
      "type": "object",
