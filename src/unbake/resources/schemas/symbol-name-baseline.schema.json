{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "unbake:symbol-name-baseline",
  "type": "object",
  "required": [
    "schema",
    "revision",
    "files"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": 1
    },
    "revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "files": {
      "type": "object",
      "propertyNames": {
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": [
            "reason",
            "lines"
          ],
          "additionalProperties": false,
          "properties": {
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "lines": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    }
  }
}
