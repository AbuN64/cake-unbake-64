{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "unbake:layout",
 "type": "object",
 "properties": {
  "schema": {
   "const": 5
  },
  "boundaries": {
   "type": "array",
   "items": {
    "type": "string",
    "minLength": 1
   }
  },
  "group": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "name": {
      "type": "string",
      "minLength": 1
     },
     "segment": {
      "type": "string",
      "minLength": 1
     },
     "members": {
      "type": "array",
      "items": {
       "type": "string",
       "minLength": 1
      }
     },
     "evidence": {
      "enum": [
       "authored",
       "proven",
       "inferred"
      ]
     },
     "signals": {
      "type": "array",
      "items": {
       "type": "string",
       "minLength": 1
      }
     },
     "source": {
      "type": "string",
      "minLength": 1
     },
     "header": {
      "type": "string",
      "minLength": 1
     },
     "subsystem": {
      "type": "string"
     },
     "library": {
      "type": "string"
     },
     "options": {
      "type": "object",
      "properties": {
       "add": {
        "type": "array",
        "items": {
         "type": "string",
         "minLength": 1
        }
       },
       "omit": {
        "type": "array",
        "items": {
         "type": "string",
         "minLength": 1
        }
       }
      },
      "required": [
       "add",
       "omit"
      ],
      "additionalProperties": false
     }
    },
    "required": [
     "name",
     "segment",
     "members",
     "evidence",
     "signals",
     "source",
     "header",
     "subsystem",
     "library"
    ],
    "additionalProperties": false
   }
  },
  "unit": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "path": {
      "type": "string",
      "minLength": 1
     },
     "kind": {
      "enum": [
       "c",
       "asm",
       "data",
       "resource"
      ]
     },
     "group": {
      "type": "string",
      "minLength": 1
     },
     "members": {
      "type": "array",
      "items": {
       "type": "string",
       "minLength": 1
      }
     },
     "toolchain": {
      "type": "string",
      "minLength": 1
     },
     "options": {
      "type": "object",
      "properties": {
       "add": {
        "type": "array",
        "items": {
         "type": "string",
         "minLength": 1
        }
       },
       "omit": {
        "type": "array",
        "items": {
         "type": "string",
         "minLength": 1
        }
       }
      },
      "required": [
       "add",
       "omit"
      ],
      "additionalProperties": false
     },
     "withheld": {
      "type": "array",
      "items": {
       "type": "string",
       "minLength": 1
      }
     }
    },
    "required": [
     "path",
     "kind",
     "group",
     "members",
     "toolchain",
     "options"
    ],
    "additionalProperties": false
   }
  },
  "authored": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "version": {
      "type": "string",
      "minLength": 1
     },
     "rom": {
      "type": "integer",
      "minimum": 0
     },
     "kind": {
      "enum": [
       "function",
       "data"
      ]
     },
     "name": {
      "type": "string",
      "minLength": 1
     }
    },
    "required": [
     "version",
     "rom",
     "kind",
     "name"
    ],
    "additionalProperties": false
   }
  },
  "fuzzy": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "member": {
      "type": "string",
      "minLength": 1
     },
     "path": {
      "type": "string",
      "minLength": 1
     },
     "scores": {
      "type": "object",
      "additionalProperties": {
       "type": "number",
       "minimum": 0,
       "maximum": 1
      }
     },
     "key": {
      "type": "object",
      "additionalProperties": {
       "type": "string",
       "minLength": 1
      }
     }
    },
    "required": [
     "member",
     "path",
     "scores"
    ],
    "additionalProperties": false
   }
  }
 },
 "required": [
  "schema",
  "group",
  "unit"
 ],
 "additionalProperties": false
}
