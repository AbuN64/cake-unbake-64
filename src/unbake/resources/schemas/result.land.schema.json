{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "unbake:result.land",
 "type": "object",
 "properties": {
  "running": {
   "type": "boolean"
  },
  "generated": {
   "type": "array",
   "items": {
    "type": "string",
    "minLength": 1
   }
  },
  "landed": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string",
      "minLength": 1
     },
     "member": {
      "type": "string",
      "minLength": 1
     },
     "operation": {
      "type": "string",
      "minLength": 1
     },
     "files": {
      "type": "array",
      "items": {
       "type": "string",
       "minLength": 1
      }
     },
     "message": {
      "type": "string",
      "minLength": 1
     }
    },
    "required": [
     "id",
     "member",
     "operation",
     "files",
     "message"
    ],
    "additionalProperties": false
   }
  },
  "refused": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string",
      "minLength": 1
     },
     "member": {
      "type": "string",
      "minLength": 1
     },
     "findings": {
      "type": "array",
      "items": {
       "type": "object",
       "properties": {
        "key": {
         "type": "string",
         "minLength": 1
        },
        "reason": {
         "type": "string",
         "minLength": 1
        },
        "path": {
         "type": "string"
        },
        "line": {
         "type": "integer",
         "minimum": 0
        },
        "unit": {
         "type": "string"
        },
        "versions": {
         "type": "array",
         "items": {
          "type": "string",
          "minLength": 1
         }
        },
        "missing": {
         "type": "array",
         "items": {
          "type": "string",
          "minLength": 1
         }
        },
        "origin": {
         "oneOf": [
          {
           "type": "null"
          },
          {
           "type": "object",
           "properties": {
            "key": {
             "type": "string",
             "minLength": 1
            },
            "file": {
             "type": "string",
             "minLength": 1
            },
            "sha256": {
             "type": "string",
             "pattern": "^[0-9a-f]{64}$"
            },
            "note": {
             "type": "string"
            }
           },
           "required": [
            "key",
            "file",
            "sha256",
            "note"
           ],
           "additionalProperties": false
          }
         ]
        },
        "blocking": {
         "type": "boolean"
        },
        "action": {
         "type": "string"
        },
        "symptoms": {
         "type": "object",
         "additionalProperties": {}
        }
       },
       "required": [
        "key",
        "reason",
        "path",
        "line",
        "unit",
        "versions",
        "missing",
        "origin",
        "blocking",
        "action",
        "symptoms"
       ],
       "additionalProperties": false
      }
     }
    },
    "required": [
     "id",
     "member",
     "findings"
    ],
    "additionalProperties": false
   }
  }
 },
 "required": [
  "running",
  "landed",
  "refused"
 ],
 "additionalProperties": false
}
