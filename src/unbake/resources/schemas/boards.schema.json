{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "unbake:boards",
 "type": "object",
 "properties": {
  "schema": {
   "const": 1
  },
  "board": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
     },
     "kind": {
      "enum": [
       "upload",
       "artifact"
      ]
     },
     "url": {
      "type": "string",
      "pattern": "^https://"
     },
     "secret": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
     },
     "artifact": {
      "type": "string",
      "minLength": 1
     }
    },
    "required": [
     "id",
     "kind"
    ],
    "additionalProperties": false,
    "oneOf": [
     {
      "properties": {
       "kind": {
        "const": "upload"
       }
      },
      "required": [
       "url",
       "secret"
      ],
      "not": {
       "required": [
        "artifact"
       ]
      }
     },
     {
      "properties": {
       "kind": {
        "const": "artifact"
       }
      },
      "required": [
       "artifact"
      ],
      "not": {
       "anyOf": [
        {
         "required": [
          "url"
         ]
        },
        {
         "required": [
          "secret"
         ]
        }
       ]
      }
     }
    ]
   }
  },
  "recomp": {
   "type": "object",
   "properties": {
    "schema": {
     "type": "string",
     "pattern": "^https://"
    },
    "fields": {
     "type": "object"
    }
   },
   "required": [
    "schema",
    "fields"
   ],
   "additionalProperties": false
  }
 },
 "required": [
  "schema",
  "board",
  "recomp"
 ],
 "additionalProperties": false
}
