{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "unbake:project",
 "type": "object",
 "properties": {
  "schema": {
   "const": 4
  },
  "name": {
   "type": "string",
   "minLength": 1
  },
  "title": {
   "type": "string",
   "minLength": 1
  },
  "toolchain": {
   "type": "string",
   "minLength": 1
  },
  "names_from": {
   "type": "string",
   "minLength": 1
  },
  "libraries": {
   "type": "array",
   "uniqueItems": true,
   "items": {
    "type": "string",
    "minLength": 1
   }
  },
  "cppflags": {
   "type": "array",
   "items": {
    "type": "string",
    "minLength": 1
   }
  },
  "cflags": {
   "type": "array",
   "items": {
    "type": "string",
    "minLength": 1
   }
  },
  "asflags": {
   "type": "array",
   "items": {
    "type": "string",
    "minLength": 1
   }
  },
  "readme_map": {
   "type": "string",
   "minLength": 1,
   "description": "the version whose memory map the README progress block shows"
  },
  "non_matching": {
   "type": "object",
   "description": "present: the Makefile also builds every draft in (make NON_MATCHING=1) and links one ROM per version under build/nm/",
   "properties": {
    "define": {
     "type": "string",
     "pattern": "^[A-Z_][A-Z0-9_]*$",
     "description": "the macro the drafts test; NON_MATCHING when absent"
    }
   },
   "additionalProperties": false
  },
  "readme_map_link": {
   "type": "string",
   "minLength": 1,
   "description": "the page the README memory map links to, at the anchor <readme_map_repo>-<readme_map> when readme_map_repo is set"
  },
  "module_map": {
   "type": "string",
   "minLength": 1,
   "description": "repo-relative path of the module map (a TSV with unit, module and prefix columns): the one authority for the function-name prefix of each module"
  },
  "readme_map_repo": {
   "type": "string",
   "minLength": 1,
   "description": "the hosted repository name that, with the readme_map version, names the anchor on the readme_map_link page"
  },
  "version": {
   "type": "object",
   "minProperties": 1,
   "additionalProperties": {
    "type": "object",
    "properties": {
     "sha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
     },
     "cartridge_id": {
      "type": "string",
      "minLength": 1
     },
     "region": {
      "type": "string",
      "minLength": 1
     },
     "description": {
      "type": "string",
      "minLength": 1
     },
     "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "object",
       "properties": {
        "name": {
         "type": "string",
         "minLength": 1
        },
        "rom": {
         "type": "integer",
         "minimum": 0
        },
        "vram": {
         "type": "integer",
         "minimum": 0
        },
        "kind": {
         "type": "string",
         "minLength": 1
        },
        "address_space": {
         "type": "string",
         "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        }
       },
       "required": [
        "name",
        "rom"
       ],
       "additionalProperties": false
      }
     },
     "size": {
      "type": "integer",
      "minimum": 1
     }
    },
    "required": [
     "sha1",
     "size"
    ],
    "additionalProperties": false
   }
  },
  "file": {
   "type": "object",
   "additionalProperties": {
    "type": "object",
    "properties": {
     "toolchain": {
      "type": "string",
      "minLength": 1
     },
     "cflags": {
      "type": "array",
      "items": {
       "type": "string",
       "minLength": 1
      }
     },
     "omit": {
      "type": "array",
      "items": {
       "type": "string",
       "minLength": 1
      }
     },
     "hilo_nops": {
      "type": "boolean"
     },
     "unrelocated": {
      "type": "boolean"
     }
    },
    "additionalProperties": false
   }
  },
  "dir": {
   "type": "object",
   "additionalProperties": {
    "type": "object",
    "properties": {
     "toolchain": {
      "type": "string",
      "minLength": 1
     },
     "cflags": {
      "type": "array",
      "items": {
       "type": "string",
       "minLength": 1
      }
     },
     "omit": {
      "type": "array",
      "items": {
       "type": "string",
       "minLength": 1
      }
     },
     "hilo_nops": {
      "type": "boolean"
     },
     "unrelocated": {
      "type": "boolean"
     }
    },
    "additionalProperties": false
   }
  },
  "library": {
   "type": "object",
   "additionalProperties": {
    "type": "object",
    "properties": {
     "toolchain": {
      "type": "string",
      "minLength": 1
     },
     "cflags": {
      "type": "array",
      "items": {
       "type": "string",
       "minLength": 1
      }
     },
     "omit": {
      "type": "array",
      "items": {
       "type": "string",
       "minLength": 1
      }
     },
     "origin": {
      "type": "string",
      "minLength": 1
     }
    },
    "additionalProperties": false
   }
  },
  "layout": {
   "type": "object",
   "properties": {
    "subsystem_header": {
     "type": "string",
     "minLength": 1
    },
    "library_header": {
     "type": "string",
     "minLength": 1
    },
    "subsystem_source": {
     "type": "string",
     "minLength": 1
    },
    "library_source": {
     "type": "string",
     "minLength": 1
    },
    "shared_headers": {
     "type": "array",
     "items": {
      "type": "string",
      "minLength": 1
     }
    },
    "module_cap": {
     "type": "integer",
     "minimum": 1
    },
    "source_roots": {
     "type": "array",
     "minItems": 1,
     "uniqueItems": true,
     "items": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/.][^/]*(/[^/.][^/]*)*$"
     }
    },
    "header_roots": {
     "type": "array",
     "minItems": 1,
     "uniqueItems": true,
     "items": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/.][^/]*(/[^/.][^/]*)*$"
     }
    }
   },
   "additionalProperties": false,
   "description": "Optional: keys of repo.toml [layout] this project replaces (source_roots, header_roots, library_source, library_header, subsystem_source, subsystem_header, shared_headers, module_cap)."
  },
  "cheat": {
   "type": "object",
   "properties": {
    "infra": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "string",
      "minLength": 1
     }
    },
    "blobs": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "string",
      "minLength": 1
     }
    },
    "facts": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "string",
      "minLength": 1
     }
    },
    "source": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "string",
      "minLength": 1
     }
    },
    "added": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "string",
      "minLength": 1
     }
    },
    "asm_home": {
     "type": "array",
     "items": {
      "type": "string",
      "minLength": 1
     }
    },
    "declaration_files": {
     "type": "string",
     "minLength": 1
    },
    "source_suffix": {
     "type": "string",
     "minLength": 1
    },
    "makefile_row": {
     "type": "string",
     "minLength": 1
    }
   },
   "additionalProperties": false,
   "description": "Optional: keys of repo.toml [cheat] this project replaces (source, asm_home, makefile_row, ...)."
  },
  "audit": {
   "type": "object",
   "properties": {
    "hex": {
     "type": "object"
    },
    "rawdata": {
     "type": "object"
    },
    "placeholder": {
     "type": "object"
    },
    "sdk": {
     "type": "object"
    },
    "generated": {
     "type": "object"
    }
   },
   "additionalProperties": false
  },
  "paths": {
   "type": "object",
   "properties": {
    "platform": {
     "type": "string",
     "minLength": 1,
     "pattern": "^[^/.][^/]*(/[^/.][^/]*)*$"
    },
    "blobs": {
     "type": "string",
     "minLength": 1,
     "pattern": "^[^/.][^/]*(/[^/.][^/]*)*$"
    },
    "prose": {
     "type": "array",
     "items": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/.][^/]*(/[^/.][^/]*)*$"
     }
    }
   },
   "additionalProperties": false,
   "description": "Optional: keys of repo.toml [paths] this project replaces (platform, blobs, prose): where its input files are."
  },
  "repo": {
   "type": "object",
   "properties": {
    "generated": {
     "type": "array",
     "items": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\s]+$"
     },
     "uniqueItems": true
    },
    "regenerate": {
     "type": "string",
     "minLength": 1,
     "pattern": "^[^/.][^/]*(/[^/.][^/]*)*$"
    }
   },
   "additionalProperties": false,
   "dependentRequired": {
    "generated": [
     "regenerate"
    ],
    "regenerate": [
     "generated"
    ]
   },
   "description": "Optional: the paths git hosts regenerate instead of merging. `generated` globs and the one `regenerate` command (repo-relative, run from the tree root) are written to .gitattributes as `<glob> generated=<command>`; the command's path is the one path under an ignored folder that .gitignore keeps."
  }
 },
 "required": [
  "schema",
  "name",
  "toolchain",
  "version"
 ],
 "additionalProperties": false
}
