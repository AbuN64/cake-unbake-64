{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "unbake:project",
 "type": "object",
 "properties": {
  "schema": {
   "const": 4
  },
  "name": {
   "type": "string",
   "minLength": 1
  },
  "title": {
   "type": "string",
   "minLength": 1
  },
  "toolchain": {
   "type": "string",
   "minLength": 1
  },
  "names_from": {
   "type": "string",
   "minLength": 1
  },
  "libraries": {
   "type": "array",
   "uniqueItems": true,
   "items": {
    "type": "string",
    "minLength": 1
   }
  },
  "cppflags": {
   "type": "array",
   "items": {
    "type": "string",
    "minLength": 1
   }
  },
  "cflags": {
   "type": "array",
   "items": {
    "type": "string",
    "minLength": 1
   }
  },
  "asflags": {
   "type": "array",
   "items": {
    "type": "string",
    "minLength": 1
   }
  },
  "readme_map": {
   "type": "string",
   "minLength": 1,
   "description": "the version whose memory map the README progress block shows"
  },
  "readme_map_link": {
   "type": "string",
   "minLength": 1,
   "description": "the page the README memory map links to, at the anchor of the version's lower-cased cartridge id"
  },
  "version": {
   "type": "object",
   "minProperties": 1,
   "additionalProperties": {
    "type": "object",
    "properties": {
     "sha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
     },
     "cartridge_id": {
      "type": "string",
      "minLength": 1
     },
     "region": {
      "type": "string",
      "minLength": 1
     },
     "description": {
      "type": "string",
      "minLength": 1
     },
     "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "object",
       "properties": {
        "name": {
         "type": "string",
         "minLength": 1
        },
        "rom": {
         "type": "integer",
         "minimum": 0
        },
        "vram": {
         "type": "integer",
         "minimum": 0
        },
        "kind": {
         "type": "string",
         "minLength": 1
        }
       },
       "required": [
        "name",
        "rom"
       ],
       "additionalProperties": false
      }
     },
     "size": {
      "type": "integer",
      "minimum": 1
     }
    },
    "required": [
     "sha1",
     "size"
    ],
    "additionalProperties": false
   }
  },
  "file": {
   "type": "object",
   "additionalProperties": {
    "type": "object",
    "properties": {
     "toolchain": {
      "type": "string",
      "minLength": 1
     },
     "cflags": {
      "type": "array",
      "items": {
       "type": "string",
       "minLength": 1
      }
     },
     "omit": {
      "type": "array",
      "items": {
       "type": "string",
       "minLength": 1
      }
     }
    },
    "additionalProperties": false
   }
  }
 },
 "required": [
  "schema",
  "name",
  "toolchain",
  "version"
 ],
 "additionalProperties": false
}
