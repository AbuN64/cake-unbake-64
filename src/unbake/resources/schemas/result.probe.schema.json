{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "unbake:result.probe",
 "type": "object",
 "properties": {
  "unit": {"type": "string", "minLength": 1},
  "members": {"type": "array", "items": {"type": "string", "minLength": 1}},
  "version": {"type": "string", "minLength": 1},
  "exact": {"type": "boolean"},
  "score": {"type": "number", "minimum": 0, "maximum": 1},
  "words": {
   "type": "object",
   "properties": {
    "built": {"type": "integer", "minimum": 0},
    "target": {"type": "integer", "minimum": 0},
    "matched": {"type": "integer", "minimum": 0}
   },
   "required": ["built", "target", "matched"],
   "additionalProperties": false
  },
  "shift": {"type": "object"},
  "diff": {"type": "array", "items": {"type": "string"}},
  "missing": {"type": "array", "items": {"type": "string"}},
  "dumps": {"type": "array", "items": {"type": "string"}}
 },
 "required": ["unit", "members", "version", "exact", "score", "words", "shift", "diff", "missing"],
 "additionalProperties": false
}
