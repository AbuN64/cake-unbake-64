{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "unbake:repo",
 "type": "object",
 "properties": {
  "schema": {
   "const": 1
  },
  "make": {
   "type": "object",
   "properties": {
    "tools": {
     "type": "object",
     "additionalProperties": {
      "type": "object",
      "properties": {
       "host": {
        "type": "string",
        "minLength": 1
       },
       "default": {
        "type": "string",
        "minLength": 1
       },
       "title": {
        "type": "string",
        "minLength": 1
       },
       "binary": {
        "type": "string",
        "minLength": 1
       },
       "download": {
        "type": "object",
        "properties": {
         "url": {
          "type": "string",
          "minLength": 1
         },
         "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
         },
         "files": {
          "type": "array",
          "items": {
           "type": "string",
           "minLength": 1
          }
         },
         "strip": {
          "type": "integer",
          "minimum": 0
         }
        },
        "required": [
         "url",
         "sha256",
         "files"
        ],
        "additionalProperties": false
       },
       "pins": {
        "type": "object",
        "additionalProperties": {
         "type": "string",
         "pattern": "^[0-9a-f]{64}$"
        }
       }
      },
      "required": [
       "host",
       "default"
      ],
      "additionalProperties": false
     }
    }
   },
   "required": [
    "tools"
   ],
   "additionalProperties": false
  },
  "readme": {
   "type": "object",
   "properties": {
    "begin": {
     "type": "string",
     "minLength": 1
    },
    "end": {
     "type": "string",
     "minLength": 1
    },
    "bar": {
     "type": "integer",
     "minimum": 1
    },
    "map_width": {
     "type": "integer",
     "minimum": 1
    },
    "dependencies_begin": {
     "type": "string",
     "minLength": 1
    },
    "dependencies_end": {
     "type": "string",
     "minLength": 1
    }
   },
   "required": [
    "begin",
    "end",
    "bar",
    "map_width",
    "dependencies_begin",
    "dependencies_end"
   ],
   "additionalProperties": false
  },
  "ignore": {
   "type": "array",
   "items": {
    "type": "string",
    "minLength": 1
   }
  },
  "splat": {
   "type": "object",
   "properties": {
    "options": {
     "type": "object",
     "additionalProperties": {
      "type": [
       "string",
       "boolean"
      ],
      "minLength": 1
     }
    }
   },
   "required": [
    "options"
   ],
   "additionalProperties": false
  },
  "layout": {
   "type": "object",
   "properties": {
    "subsystem_header": {
     "type": "string",
     "minLength": 1
    },
    "library_header": {
     "type": "string",
     "minLength": 1
    },
    "subsystem_source": {
     "type": "string",
     "minLength": 1
    },
    "library_source": {
     "type": "string",
     "minLength": 1
    },
    "shared_headers": {
     "type": "array",
     "items": {
      "type": "string",
      "minLength": 1
     }
    },
    "module_cap": {
     "type": "integer",
     "minimum": 1
    }
   },
   "required": [
    "subsystem_header",
    "library_header",
    "shared_headers",
    "subsystem_source",
    "library_source",
    "module_cap"
   ],
   "additionalProperties": false
  },
  "wheel": {
   "type": "string",
   "minLength": 1
  },
  "forge": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "properties": {
     "path": {
      "type": "string",
      "minLength": 1
     },
     "template": {
      "type": "string",
      "minLength": 1
     },
     "values": {
      "type": "object",
      "additionalProperties": {
       "type": "string"
      }
     }
    },
    "required": [
     "path",
     "template",
     "values"
    ],
    "additionalProperties": false
   }
  },
  "ci_host": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "memory_parent_bytes",
    "memory_worker_bytes",
    "cache_max_bytes",
    "serial_seconds",
    "serial_cores",
    "pool_fill",
    "pool_fanout",
    "author_name",
    "author_email"
   ],
   "properties": {
    "memory_parent_bytes": {
     "type": "integer"
    },
    "memory_worker_bytes": {
     "type": "integer"
    },
    "cache_max_bytes": {
     "type": "integer"
    },
    "serial_seconds": {
     "type": "number"
    },
    "serial_cores": {
     "type": "number"
    },
    "pool_fill": {
     "type": "number"
    },
    "pool_fanout": {
     "type": "number"
    },
    "author_name": {
     "type": "string"
    },
    "author_email": {
     "type": "string"
    }
   }
  },
  "splat_pip": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "string",
    "minLength": 1
   }
  }
 },
 "required": [
  "schema",
  "wheel",
  "forge",
  "make",
  "readme",
  "ignore",
  "splat",
  "layout",
  "ci_host",
  "splat_pip"
 ],
 "additionalProperties": false
}
