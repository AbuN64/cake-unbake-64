{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "unbake:result.map",
 "type": "object",
 "properties": {
  "path": {
   "type": "string",
   "minLength": 1
  },
  "digest": {
   "type": "string",
   "minLength": 1
  },
  "counts": {
   "type": "object",
   "properties": {
    "src_c": {
     "type": "integer",
     "minimum": 0
    },
    "include_h": {
     "type": "integer",
     "minimum": 0
    },
    "units": {
     "type": "integer",
     "minimum": 0
    },
    "modules": {
     "type": "integer",
     "minimum": 0
    },
    "members": {
     "type": "integer",
     "minimum": 0
    }
   },
   "required": [
    "src_c",
    "include_h",
    "units",
    "modules",
    "members"
   ],
   "additionalProperties": false
  },
  "moves": {
   "type": "object",
   "properties": {
    "path": {
     "type": "string",
     "minLength": 1
    },
    "count": {
     "type": "integer",
     "minimum": 0
    },
    "folders": {
     "type": "object",
     "additionalProperties": {
      "type": "integer",
      "minimum": 0
     }
    }
   },
   "required": [
    "path",
    "count",
    "folders"
   ],
   "additionalProperties": false
  }
 },
 "required": [
  "path",
  "digest",
  "counts"
 ],
 "additionalProperties": false
}
