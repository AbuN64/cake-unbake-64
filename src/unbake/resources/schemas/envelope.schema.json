{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "unbake:envelope",
 "type": "object",
 "properties": {
  "ok": {
   "type": "boolean"
  },
  "invocation": {
   "type": "string",
   "minLength": 1
  },
  "result": {
   "type": [
    "object",
    "null"
   ]
  },
  "findings": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "Code": {
      "type": "string",
      "minLength": 1
     },
     "Severity": {
      "enum": [
       "Refuse",
       "Warn"
      ]
     },
     "File": {
      "type": "string"
     },
     "Line": {
      "type": "integer",
      "minimum": 0
     },
     "Message": {
      "type": "string",
      "minLength": 1
     },
     "NextStep": {
      "type": "string",
      "minLength": 1
     },
     "Detail": {
      "type": "object",
      "properties": {
       "Unit": {
        "type": "string"
       },
       "Versions": {
        "type": "array",
        "items": {
         "type": "string",
         "minLength": 1
        }
       },
       "Missing": {
        "type": "array",
        "items": {
         "type": "string",
         "minLength": 1
        }
       },
       "Origin": {
        "oneOf": [
         {
          "type": "null"
         },
         {
          "type": "object",
          "properties": {
           "key": {
            "type": "string",
            "minLength": 1
           },
           "file": {
            "type": "string",
            "minLength": 1
           },
           "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
           },
           "note": {
            "type": "string"
           }
          },
          "required": [
           "key",
           "file",
           "sha256",
           "note"
          ],
          "additionalProperties": false
         }
        ]
       },
       "Symptoms": {
        "type": "object",
        "additionalProperties": {}
       }
      },
      "additionalProperties": false
     }
    },
    "required": [
     "Code",
     "Severity",
     "File",
     "Line",
     "Message",
     "NextStep"
    ],
    "additionalProperties": false
   }
  },
  "stages": {
   "type": [
    "object",
    "null"
   ]
  },
  "cache": {
   "type": "object",
   "properties": {
    "hits": {
     "type": "integer"
    },
    "misses": {
     "type": "integer"
    },
    "kinds": {
     "type": "object",
     "additionalProperties": {
      "type": "object",
      "properties": {
       "hits": {
        "type": "integer"
       },
       "misses": {
        "type": "integer"
       }
      },
      "required": [
       "hits",
       "misses"
      ],
      "additionalProperties": false
     }
    }
   },
   "required": [
    "hits",
    "misses",
    "kinds"
   ],
   "additionalProperties": false
  },
  "summary": {
   "type": "object",
   "properties": {
    "Refuse": {
     "type": "integer",
     "minimum": 0
    },
    "Warn": {
     "type": "integer",
     "minimum": 0
    },
    "Codes": {
     "type": "object",
     "additionalProperties": {
      "type": "object",
      "properties": {
       "Refuse": {
        "type": "integer"
       },
       "Warn": {
        "type": "integer"
       }
      },
      "additionalProperties": false
     }
    }
   },
   "required": [
    "Refuse",
    "Warn",
    "Codes"
   ],
   "additionalProperties": false
  }
 },
 "required": [
  "ok",
  "invocation",
  "result",
  "findings",
  "summary",
  "stages",
  "cache"
 ],
 "additionalProperties": false
}
