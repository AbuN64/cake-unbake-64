{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "unbake:flow",
 "type": "object",
 "properties": {
  "schema": {
   "const": 1
  },
  "fuzzy": {
   "type": "object",
   "properties": {
    "min_gain": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    },
    "chunk": {
     "type": "integer",
     "minimum": 1
    }
   },
   "required": [
    "min_gain",
    "chunk"
   ],
   "additionalProperties": false
  }
 },
 "required": [
  "schema",
  "fuzzy"
 ],
 "additionalProperties": false
}
