name: CI
on:  # Generated file: every job calls ci/run
  pull_request:
  push:
    branches: [main]
  workflow_dispatch:
permissions:
  contents: read
jobs:
  check:
    runs-on: ubuntu-latest
    steps:
      - uses: ${checkout}
      - uses: ${python}
        with:
          python-version: "3.13"
      - run: sh ci/run check
  audit:
    runs-on: ubuntu-latest
    steps:
      - uses: ${checkout}
        with:
          fetch-depth: 0
      - uses: ${python}
        with:
          python-version: "3.13"
      - env:
          CI_BASE: $${{ github.event.pull_request.base.sha || github.event.before }}
        run: sh ci/run audit
