#!/bin/sh
# Generated file. The one CI entry point: sh ci/run STAGE. The GitHub and GitLab files only call it.
#   check        the committed tree: progress reports and the files the site reads
#   audit        the source rules a change adds (CI_BASE: the revision it is compared with)
#   board NAME   publish the progress reports to one external board (REPO owner/name, COMMIT sha)
set -eu
cd "$$(dirname "$$0")/.."
WHEEL=${wheel}
VERSIONS="${versions}"

base() {
    b=$${CI_BASE:-}
    case "$$b" in ""|*0000000000000000000000000000000000000000) b=4b825dc642cb6eb9a060e54bf8d69288fbee4904 ;; esac
    git cat-file -e "$$b^{tree}" 2>/dev/null || b=HEAD
    echo "$$b"
}

case "$${1:-}" in
check)
    make check CHECK=tree
    ;;
audit)
    pip install "$$WHEEL"
    unbake audit --against "$$(base)"
    ;;
board)
    name=$${2:-}
    if [ -f ".boards/$$name" ]; then
        echo "$$name: progress.json is unchanged since this board last published"
        exit 0
    fi
    case "$$name" in
${boards}
    *)
        echo "unknown board: $$name" >&2
        exit 2
        ;;
    esac
    mkdir -p .boards
    : >".boards/$$name"
    ;;
*)
    echo "usage: sh ci/run check | audit | board NAME" >&2
    exit 2
    ;;
esac
