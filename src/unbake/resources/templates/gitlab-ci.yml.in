audit:
  image: ${audit_image}
  variables:
    GIT_DEPTH: "0"
  script:
    - pip install ${unbake_wheel}
    - BASE="$${CI_MERGE_REQUEST_DIFF_BASE_SHA:-$$CI_COMMIT_BEFORE_SHA}"
    - case "$$BASE" in ""|*0000000000000000000000000000000000000000) BASE=4b825dc642cb6eb9a060e54bf8d69288fbee4904;; esac
    - apt-get update && apt-get install -y --no-install-recommends git
    - unbake audit --against "$$BASE"

check:
  image: ${image}
  before_script:
    - apt-get update
    - apt-get install -y --no-install-recommends ${packages}
  script:
    - make check CHECK=tree
  artifacts:
    paths:
      - versions/*/report.json
