# Generated file: every job calls ci/run.
check:
  image: ${image}
  rules:
    - if: $$CI_PIPELINE_SOURCE != "schedule"
  before_script:
    - apt-get update
    - apt-get install -y --no-install-recommends ${packages}
  script:
    - sh ci/run check

audit:
  image: ${audit_image}
  rules:
    - if: $$CI_PIPELINE_SOURCE != "schedule"
  variables:
    GIT_DEPTH: "0"
  before_script:
    - apt-get update
    - apt-get install -y --no-install-recommends git
  script:
    - CI_BASE="$${CI_MERGE_REQUEST_DIFF_BASE_SHA:-$$CI_COMMIT_BEFORE_SHA}" sh ci/run audit
