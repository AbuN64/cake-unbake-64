name: Boards
on:  # generated by unbake: once a day, and a board publishes only after progress.json changed since it last did
  schedule:
    - cron: "0 13 * * *"
  workflow_dispatch:
    inputs:
      force:
        description: Publish even when progress.json is unchanged
        type: boolean
        default: false
permissions:
  contents: read
jobs:
${jobs}