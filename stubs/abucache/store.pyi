from collections.abc import Callable as Callable
from collections.abc import Iterable
from pathlib import Path

class CacheFull(RuntimeError): ...

class ContentCache:
    directory: Path
    def __init__(self, directory: Path, size_limit: int, count: Callable[[str, bool], None] = ...) -> None: ...
    def cached(self, kind: str, key: str, produce: Callable[[], bytes]) -> bytes: ...
    def count(self, kind: str, hit: bool) -> None: ...
    def get(self, kind: str, key: str) -> bytes | None: ...
    def put(self, kind: str, key: str, value: bytes) -> None: ...
    def put_many(self, items: Iterable[tuple[str, str, bytes]]) -> None: ...
    def finish(
        self, root: Path, identity: str, installed: Callable[[str], bool] = ..., keep_commits: int = ...
    ) -> None: ...
    def collect(
        self, installed: Callable[[str], bool] = ..., now: float | None = ..., keep_commits: int = ...
    ) -> int: ...

def forget() -> None: ...
def open_cache(directory: Path, size_limit: int, count: Callable[[str, bool], None] = ...) -> ContentCache: ...
def take_touched() -> dict[str, list[str]]: ...
def absorb_touched(taken: dict[str, list[str]]) -> None: ...
